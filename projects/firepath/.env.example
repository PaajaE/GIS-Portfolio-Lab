# FirePath optional keys. Copy to .env (git-ignored): `make env`, then fill in the values.
# Never commit .env and never paste keys into chat or issues.

# NASA FIRMS MAP_KEY (free, emailed): https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# Synoptic API token (optional; RAWS is only a wind cross-check): https://developers.synopticdata.com
SYNOPTIC_TOKEN=
